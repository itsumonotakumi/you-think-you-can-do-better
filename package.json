{
  "name": "you-think-you-can-do-better",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "validate": "node --experimental-strip-types tools/validate/index.ts",
    "build:data": "node --experimental-strip-types tools/build-data/index.ts",
    "dev": "npm run build:data && vite",
    "build": "npm run validate && npm run build:data && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "~7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
